---
import { TAGS } from "../lib/tags";
import Badges from "./ui/Badges.astro";

const EXPERIENCIA = [
  {
    date: "Enero 2026 - Presente",
    title: "Desarrollador Fullstack",
    place: "Naviomar",
    description: "",
    badages: [TAGS.REACT, TAGS.NUXT, TAGS.TYPESCRIPT, TAGS.LARAVEL],
  },
  {
    date: "Enero 2024 - Enero 2026",
    title: "Desarrollador Frontend",
    place: "UAM-I",
    description:
      "Desarrollé una aplicación web para la gestión integral de insumos, pacientes y expedientes médicos utilizando Next.js (React), participando también en la fase inicial del desarrollo Back-End con Spring Boot.",
    badages: [
      TAGS.NEXTJS,
      TAGS.REACT,
      TAGS.TYPESCRIPT,
      TAGS.SPRINGBOOT,
      TAGS.JAVA,
      TAGS.POSTGRESQL,
      TAGS.MONGODB,
      TAGS.FIGMA,
    ],
  },
  {
    date: "Febrero 2024 - Agosto 2024",
    title: "Desarrollador Backend",
    place: "UAM-I",
    description:
      "Colaboré en el desarrollo de un sistema de gestión de préstamos de dispositivos, para reemplazar un software obsoleto.",
    badages: [TAGS.LARAVEL],
  },
];
---

<div class="flex flex-col gap-10">
  {
    EXPERIENCIA.map((item) => (
      <div class="border-l-2 border-sky-400/35 pl-6 relative">
        <div class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-sky-400" />
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-2">
          <h3 class="font-heading text-lg sm:text-xl font-semibold text-zinc-100">
            {item.title} <span class="text-sky-400 font-normal">·</span>{" "}
            <span class="text-zinc-300">{item.place}</span>
          </h3>
          <time class="text-xs sm:text-sm text-zinc-400 font-medium">
            {item.date}
          </time>
        </div>

        {item.description && (
          <p class="text-sm sm:text-base text-zinc-300 leading-relaxed mb-4 max-w-3xl">
            {item.description}
          </p>
        )}

        {item.badages && item.badages.length > 0 && (
          <div class="pt-1">
            <Badges badges={item.badages} />
          </div>
        )}
      </div>
    ))
  }
</div>

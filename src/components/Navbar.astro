---
import Mail from "./icons/Mail.astro";
---

<nav
  class="fixed top-3.5 sm:top-5 left-1/2 -translate-x-1/2 z-50 flex items-center justify-between gap-3 sm:gap-8 px-4 sm:px-6 py-2.5 sm:py-3 w-[min(980px,92vw)] bg-zinc-950/90 backdrop-blur-2xl backdrop-saturate-150 border border-white/15 rounded-full shadow-2xl shadow-black/80"
>
  <a
    href="#presentation"
    class="font-heading font-bold text-sm sm:text-base text-zinc-100 tracking-wide hover:text-sky-400 transition-colors whitespace-nowrap hidden md:inline-block"
  >
    Axel Huerta
  </a>

  <div
    class="flex items-center justify-center flex-1 md:flex-none gap-4 sm:gap-6 text-xs sm:text-sm font-medium text-zinc-300"
  >
    <a
      href="#experience"
      class="hover:text-sky-400 transition-colors py-1 px-1"
    >
      Experiencia
    </a>
    <a href="#projects" class="hover:text-sky-400 transition-colors py-1 px-1">
      Proyectos
    </a>
    <a
      href="#certificates"
      class="hover:text-sky-400 transition-colors py-1 px-1"
    >
      Certificados
    </a>
  </div>

  <div>
    <a
      href="mailto:axelhuerta.dev@gmail.com"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-sky-400/80 text-sky-400 hover:bg-sky-400/10 hover:border-sky-300 hover:text-sky-300 transition-all text-xs sm:text-sm font-medium whitespace-nowrap shadow-sm shadow-sky-500/10"
      aria-label="Contacto"
    >
      <Mail class="w-3.5 h-3.5 stroke-current" />
      <span class="hidden sm:inline">Contacto</span>
    </a>
  </div>
</nav>

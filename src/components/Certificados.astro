---
import go from "../assets/certificates/go.png";
import tsCodigoFacilito from "../assets/certificates/ts-codigo-facilito.png";
import tsUdemy from "../assets/certificates/ts-udemy.png";
import jsHtmlCssNode from "../assets/certificates/js-html-css-node.png";
import programaOne from "../assets/certificates/programa-one.png";
import { TAGS } from "../lib/tags";
import Badges from "./ui/Badges.astro";
import Button from "./Button.astro";
import Pdf from "./icons/Pdf.astro";

const certificates = [
  {
    title: "Curso profesional de Go",
    platform: "Código Facilito",
    image: go,
    badges: [TAGS.GO],
  },
  {
    title: "Curso: Aprende Javascript ES9, HTML, CSS3 y NodeJS desde cero",
    platform: "Udemy",
    image: jsHtmlCssNode,
    badges: [TAGS.JAVASCRIPT, TAGS.HTML, TAGS.CSS3, TAGS.NODE],
  },
  {
    title: "Curso: Oracle Next Education F2 T5 Back-end",
    platform: "Alura Latam",
    image: programaOne,
    badges: [TAGS.JAVA, TAGS.SPRINGBOOT],
  },
  {
    title: "Curso Profesional de Typescript",
    platform: "Código Facilito",
    image: tsCodigoFacilito,
    badges: [TAGS.TYPESCRIPT],
  },
  {
    title: "Curso: Typescript Sin Fronteras",
    platform: "Udemy",
    image: tsUdemy,
    badges: [TAGS.TYPESCRIPT],
  },
];
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-fr">
  {
    certificates.map(({ title, platform, image, badges }) => (
      <article class="flex flex-col rounded-2xl overflow-hidden bg-white/[0.04] backdrop-blur-xl border border-white/10 shadow-xl transition-all duration-300 hover:border-sky-400/30 hover:bg-white/[0.06] h-full">
        <div class="w-full h-48 sm:h-52 bg-zinc-900/40 border-b border-white/10 overflow-hidden">
          <img
            src={image?.src ?? image}
            alt={`Certificado de ${title} de ${platform}`}
            class="w-full h-full object-cover object-center transition-transform duration-500 hover:scale-105"
            loading="lazy"
          />
        </div>

        <div class="p-5 flex flex-col gap-3 flex-1 justify-between">
          <div class="space-y-1">
            <h3 class="font-heading text-base font-semibold text-zinc-100 leading-snug">
              {title}
            </h3>
            <p class="text-xs text-zinc-400 font-medium">{platform}</p>
          </div>

          <div class="pt-2">
            <Badges badges={badges} />
          </div>
        </div>
      </article>
    ))
  }
</div>

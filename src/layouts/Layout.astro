---
import "../styles/global.css";
import "@fontsource-variable/montserrat";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>Portfolio | Axel Huerta</title>
    </head>
    <body class="bg-ctp-base text-ctp-text scroll-smooth">
        <div
            class="pointer-events-none fixed inset-0 -z-10 bg-ctp-base bg-[radial-gradient(#585b7040_1px,#1e1e2e_1px)] bg-[size:20px_20px]"
            aria-hidden="true"
        ></div>
        <slot />
    </body>
</html>

<style>
    body {
        font-family: "Montserrat Variable", sans-serif;
    }
</style>

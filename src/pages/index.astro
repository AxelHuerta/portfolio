---
import Experiencia from "../components/Experiencia.astro";
import Project from "../components/Project.astro";
import Layout from "../layouts/Layout.astro";
import Certificados from "../components/Certificados.astro";
import Navbar from "../components/Navbar.astro";
import AboutMe from "../components/AboutMe.astro";
---

<Layout>
  <Navbar />
  <main class="max-w-5xl mx-auto px-4 sm:px-8 pb-24 pt-16">
    <!-- Presentación / Perfil -->
    <section
      id="presentation"
      class="min-h-[85vh] flex flex-col justify-center pt-20 pb-16 scroll-mt-28"
    >
      <AboutMe />
    </section>

    <!-- Experiencia -->
    <section id="experience" class="py-20 scroll-mt-28">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-zinc-100 mb-10">
        Trayectoria profesional
      </h2>
      <Experiencia />
    </section>

    <!-- Proyectos -->
    <section id="projects" class="py-20 scroll-mt-28">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-zinc-100 mb-10">
        Proyectos destacados
      </h2>
      <Project />
    </section>

    <!-- Certificados -->
    <section id="certificates" class="py-20 scroll-mt-28">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-zinc-100 mb-10">
        Formación continua
      </h2>
      <Certificados />
    </section>
  </main>

  <footer class="border-t border-white/10 py-10 px-4 sm:px-8 max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs sm:text-sm text-zinc-400">
    <p>© {new Date().getFullYear()} Axel Huerta. Todos los derechos reservados.</p>
    <a
      href="mailto:axelhuerta.dev@gmail.com"
      class="text-sky-400 hover:text-sky-300 transition-colors"
    >
      axelhuerta.dev@gmail.com
    </a>
  </footer>
</Layout>
